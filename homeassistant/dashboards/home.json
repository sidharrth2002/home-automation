{
  "views": [
    {
      "title": "Home",
      "path": "home",
      "type": "sections",
      "max_columns": 4,
      "icon": "mdi:home-variant",
      "badges": [
        {
          "type": "entity",
          "entity": "input_boolean.music_sync",
          "name": "Sync",
          "show_name": true,
          "show_state": true
        },
        {
          "type": "entity",
