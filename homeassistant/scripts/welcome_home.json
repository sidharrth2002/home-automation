{
  "alias": "Welcome home",
  "icon": "mdi:home-heart",
  "description": "The arrival sequence: the TV lamps power up in arc-reactor blue, the desk lamp comes on at its adaptive level, the lamps settle to warm white, the TV wakes and says hello. If the TV was already on, the greeting comes from the Mac instead, so it doesn't interrupt whatever's playing. WiZ bulbs can't do transitions, so the power-up is a quick ramp of steps.",
  "mode": "single",
  "fields": {
    "text": {
      "name": "Greeting",
      "description": "What to say",
      "default": "Welcome home, Sid.",
      "selector": {"text": {}}
    }
  },
  "sequence": [
    {
      "variables": {
        "greeting": "{{ text if text is defined and text else 'Welcome home, Sid.' }}",
        "tv_was_off": "{{ is_state('media_player.smart_tv_pro', 'off') }}"
      }
    },
    {
      "action": "light.turn_on",
      "target": {"entity_id": ["light.wiz_rgbw_tunable_624d4e", "light.wiz_rgbw_tunable_4b472c"]},
      "data": {"rgb_color": [0, 170, 255], "brightness_pct": 8}
    },
    {"delay": {"milliseconds": 350}},
    {
      "action": "light.turn_on",
      "target": {"entity_id": ["light.wiz_rgbw_tunable_624d4e", "light.wiz_rgbw_tunable_4b472c"]},
      "data": {"rgb_color": [0, 190, 255], "brightness_pct": 22}
    },
    {
      "if": [{"condition": "template", "value_template": "{{ not tv_was_off }}"}],
      "then": [{"event": "home_say", "event_data": {"text": "{{ greeting }}", "target": "mac"}}]
    },
    {"delay": {"milliseconds": 350}},
    {
      "action": "light.turn_on",
      "target": {"entity_id": ["light.wiz_rgbw_tunable_624d4e", "light.wiz_rgbw_tunable_4b472c"]},
      "data": {"rgb_color": [40, 210, 255], "brightness_pct": 40}
    },
    {
      "action": "light.turn_on",
      "target": {"entity_id": "light.desk_lamp"},
      "data": {
        "color_temp_kelvin": "{{ states('sensor.desk_lamp_target_colour') | int(2700) }}",
        "brightness_pct": "{{ states('sensor.desk_lamp_target_brightness') | int(30) }}"
      }
    },
    {"delay": {"milliseconds": 2500}},
    {
      "action": "light.turn_on",
      "target": {"entity_id": ["light.wiz_rgbw_tunable_624d4e", "light.wiz_rgbw_tunable_4b472c"]},
      "data": {"color_temp_kelvin": 2700, "brightness_pct": 20}
    },
    {
      "if": [{"condition": "template", "value_template": "{{ tv_was_off }}"}],
      "then": [
        {"action": "media_player.turn_on", "target": {"entity_id": "media_player.smart_tv_pro"}},
        {"event": "home_say", "event_data": {"text": "{{ greeting }}", "target": "tv"}}
      ]
    }
  ]
}
