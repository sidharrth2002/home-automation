{
  "alias": "Welcome home",
  "icon": "mdi:home-heart",
  "description": "The arrival sequence: the TV lamps power up in arc-reactor blue, the Mac says hello, the desk lamp comes on at its adaptive level, the TV lamps settle to warm white and the TV wakes. WiZ bulbs can't do transitions, so the power-up is a quick ramp of steps.",
  "mode": "single",
  "fields": {
    "text": {
      "name": "Greeting",
      "description": "What to say",
      "default": "Welcome home, Sid.",
      "selector": {"text": {}}
    }
  },
  "sequence": [
    {
      "action": "light.turn_on",
      "target": {"entity_id": ["light.wiz_rgbw_tunable_624d4e", "light.wiz_rgbw_tunable_4b472c"]},
      "data": {"rgb_color": [0, 170, 255], "brightness_pct": 8}
    },
    {"delay": {"milliseconds": 350}},
    {
      "action": "light.turn_on",
      "target": {"entity_id": ["light.wiz_rgbw_tunable_624d4e", "light.wiz_rgbw_tunable_4b472c"]},
      "data": {"rgb_color": [0, 190, 255], "brightness_pct": 22}
    },
    {
      "event": "home_say",
      "event_data": {"text": "{{ text if text is defined and text else 'Welcome home, Sid.' }}"}
    },
    {"delay": {"milliseconds": 350}},
    {
      "action": "light.turn_on",
      "target": {"entity_id": ["light.wiz_rgbw_tunable_624d4e", "light.wiz_rgbw_tunable_4b472c"]},
      "data": {"rgb_color": [40, 210, 255], "brightness_pct": 40}
    },
    {
      "action": "light.turn_on",
      "target": {"entity_id": "light.desk_lamp"},
      "data": {
        "color_temp_kelvin": "{{ states('sensor.desk_lamp_target_colour') | int(2700) }}",
        "brightness_pct": "{{ states('sensor.desk_lamp_target_brightness') | int(30) }}"
      }
    },
    {"delay": {"milliseconds": 2500}},
    {
      "action": "light.turn_on",
      "target": {"entity_id": ["light.wiz_rgbw_tunable_624d4e", "light.wiz_rgbw_tunable_4b472c"]},
      "data": {"color_temp_kelvin": 2700, "brightness_pct": 20}
    },
    {
      "if": [{"condition": "state", "entity_id": "media_player.smart_tv_pro", "state": "off"}],
      "then": [{"action": "media_player.turn_on", "target": {"entity_id": "media_player.smart_tv_pro"}}]
    }
  ]
}
