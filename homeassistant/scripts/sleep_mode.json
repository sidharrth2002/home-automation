{
  "alias": "Sleep",
  "icon": "mdi:power-sleep",
  "description": "Wind down for bed: music and TV off, then the Sleep lights (a warm glow that steps down to dark over ~12 minutes). Any other scene cancels it.",
  "mode": "restart",
  "sequence": [
    {
      "if": [
        {
          "condition": "state",
          "entity_id": "media_player.smart_tv_pro",
          "state": "on"
        }
      ],
      "then": [
        {
          "action": "media_player.turn_off",
          "target": {
            "entity_id": "media_player.smart_tv_pro"
          }
        }
      ]
    },
    {
      "action": "script.sleep_lights"
    }
  ]
}
