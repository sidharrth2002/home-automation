# Home Assistant long-lived access token (Profile -> Security -> Long-lived access tokens)
TOKEN=
# Optional: comma-separated WiZ bulb IPs if broadcast discovery can't see them
WIZ_BULB_IPS=
# WiZ bulbs music sync must never touch (comma-separated MACs), e.g. the adaptive desk lamp
WIZ_EXCLUDE_MACS=
# Your phone's Wi-Fi address for this network (Settings > Wi-Fi > (i) > Wi-Fi Address)
PRESENCE_PHONE_MAC=

# iCloud calendars on the dashboard: your Apple ID email + an app-specific password (account.apple.com)
ICLOUD_USERNAME=
ICLOUD_APP_PASSWORD=

# The TV's address on the home network, for tv-app/deploy
TV_HOST=

# OneDrive folders the photo frame looks in (separated by ";"), via the rclone remote "onedrive"
PHOTOS_DIRS=Pictures/Camera Roll

# The TV's Cast device in Home Assistant (media_player.…). Music sync on the mic goes still while it's paused.
TV_CAST=

# The Bluetooth LED strip behind the cabinet (MELK / ELK-BLEDOM controllers): the start of its Bluetooth name.
# Set it to run the backlight service.
BACKLIGHT_NAME=

# Central state service (core/): the admin token the services use (python -c 'import secrets; print(secrets.token_urlsafe(32))').
# Clients like another Claude session get their own scoped token: python -m core token add <name> <scope>...
CORE_TOKEN=
# Where it listens: 127.0.0.1 keeps it on this machine; on a Pi serving other devices, the LAN address.
CORE_BIND=127.0.0.1
CORE_PORT=8790

# Telemetry (telemetry/): every service sends logs, metrics and traces here over OpenTelemetry. Locally that's the
# `telemetry` container (Grafana at http://localhost:3000); a hosted backend later is just this URL plus
# OTEL_EXPORTER_OTLP_HEADERS for its key. Leave it empty to turn telemetry off.
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
