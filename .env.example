# Home Assistant long-lived access token (Profile -> Security -> Long-lived access tokens)
TOKEN=
# Optional: comma-separated WiZ bulb IPs if broadcast discovery can't see them
WIZ_BULB_IPS=
# WiZ bulbs music sync must never touch (comma-separated MACs), e.g. the adaptive desk lamp
WIZ_EXCLUDE_MACS=
# Your phone's Wi-Fi address for this network (Settings > Wi-Fi > (i) > Wi-Fi Address)
PRESENCE_PHONE_MAC=

# iCloud calendars on the dashboard: your Apple ID email + an app-specific password (account.apple.com)
ICLOUD_USERNAME=
ICLOUD_APP_PASSWORD=

# The TV's address on the home network, for tv-app/deploy
TV_HOST=

# OneDrive folders the photo frame looks in (separated by ";"), via the rclone remote "onedrive"
PHOTOS_DIRS=Pictures/Camera Roll
