#!/bin/bash
# Build the Android TV app and install it on the TV over the home network.
#   tv-app/deploy            build, install and open it
#   tv-app/deploy --build    just build the APK
#   tv-app/deploy --no-open  build and install without opening it (the TV is off, or someone's watching)
# The TV needs developer options with USB debugging on (the first connection asks you to allow it on the TV).
# TV_HOST in ../.env is the TV's address. Home Assistant's address (this Mac's) and the app's own token are baked
# into the app at build time; the token lives in ../data/tv/token, never in the repo.
set -euo pipefail
cd "$(dirname "$0")"
export JAVA_HOME="${JAVA_HOME:-$(brew --prefix openjdk@17)/libexec/openjdk.jdk/Contents/Home}"
export ANDROID_HOME="${ANDROID_HOME:-$HOME/Library/Android/sdk}"
MAC=$(ipconfig getifaddr en0 2>/dev/null || ipconfig getifaddr en1)
HA="http://$MAC:8123"

# The app talks to Home Assistant itself, with a token of its own (made once, kept out of the repo).
TOKEN_FILE=../data/tv/token
if [[ ! -s $TOKEN_FILE ]]; then
  mkdir -p "$(dirname "$TOKEN_FILE")"
  (umask 077; ../.venv/bin/python make_token.py > "$TOKEN_FILE")
  echo "made the TV app's Home Assistant token (revoke it in your HA profile: \"Home TV app\")"
fi
./demo-data >/dev/null  # the demo household, in step with the Hub's
./gradlew -q assembleRelease -PhaUrl="$HA" -PhaToken="$(cat "$TOKEN_FILE")"
APK=app/build/outputs/apk/release/app-release.apk
echo "built $APK (Home Assistant at $HA)"
[[ ${1:-} == --build ]] && exit 0

source ./adb.sh  # finds the TV and sets $ADB and $SERIAL
had_home=$("$ADB" -s "$SERIAL" shell settings get secure enabled_accessibility_services | grep -c HomeButtonService || true)
"$ADB" -s "$SERIAL" install -r "$APK"
# an update can drop the Home button service from Android's list; put it back if it was on
if [[ $had_home != 0 ]] && ! "$ADB" -s "$SERIAL" shell settings get secure enabled_accessibility_services | grep -q HomeButtonService; then
  ./home on >/dev/null
fi
if [[ ${1:-} == --no-open ]]; then echo "installed on the TV (not opened)"; exit 0; fi
"$ADB" -s "$SERIAL" shell am start -n com.sid.home/.MainActivity >/dev/null
echo "installed and opened on the TV"
