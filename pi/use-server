#!/bin/bash
# Point this Mac at the server: it stops running Home Assistant and the always-on services, and runs only what needs
# a Mac (music sync: its audio; announcements: its voices), talking to Home Assistant, core and the strip on the
# server. Run ON the Mac, after pi/move-from-mac and once the server is up.
#
#   pi/use-server <pi address>    e.g. homepi.local or its IP
#   pi/use-server --undo          back to running everything here (the .env from before)
set -euo pipefail
cd "$(dirname "$0")/.."
BACKUP=data/env.before-server

if [[ ${1:-} == --undo ]]; then
  [[ -f $BACKUP ]] || { echo "nothing to undo ($BACKUP is missing)" >&2; exit 1; }
  cp "$BACKUP" .env && chmod 600 .env
  echo "the Mac runs everything again: ./home reload (and ./home up for Home Assistant)"
  exit 0
fi
PI=${1:?usage: pi/use-server <pi address> | --undo}
curl -sf -o /dev/null --max-time 5 "http://$PI:8123/manifest.json" \
  || { echo "Home Assistant isn't answering at http://$PI:8123; is the server up (./home up on the Pi)?" >&2; exit 1; }

[[ -f $BACKUP ]] || cp .env "$BACKUP"
./home down  # with the old .env, so Home Assistant here stops too
set_key() {  # KEY VALUE: replace or add
  grep -v "^$1=" .env > .env.tmp || true
  echo "$1=$2" >> .env.tmp
  mv .env.tmp .env
}
set_key HOME_DOCKER 0
set_key HOME_ONLY "music_sync,announce"
set_key HA_URL "ws://$PI:8123/api/websocket"
set_key HA_HTTP "http://$PI:8123"
set_key CORE_URL "http://$PI:8790"
set_key BACKLIGHT_HOST "$PI"
set_key ANNOUNCE_SERVE_PORT 8791
# the TV app is built with Home Assistant's address in it; Android TV doesn't reliably resolve .local names, so an IP
# (give the Pi a fixed one: a DHCP reservation on the router)
IP=$(python3 -c 'import socket, sys; print(socket.gethostbyname(sys.argv[1]))' "$PI")
set_key TV_HA_HOST "$IP"
set_key WIDGET_HOST "$IP"
chmod 600 .env
./home up
cat <<EOF
The Mac now runs music sync and announcements against the server at $PI (undo: pi/use-server --undo).
Still to do, once: tv-app/deploy --no-open   (rebuilds the TV app for $IP)
                    .venv/bin/python -m widget install --copy   (the phone widget, pointed at the server:
                    paste it over the Scriptable script)
EOF
