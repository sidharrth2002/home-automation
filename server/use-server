#!/bin/bash
# Point this Mac at the server: it stops running Home Assistant and the always-on services, and runs only what needs
# a Mac (music sync: its audio; announcements: its voices), talking to Home Assistant, core and the strip on the
# server. Run ON the Mac, after server/move-from-mac and once the server is up.
#
#   server/use-server <server address>  e.g. homeserver.local or its IP
#   server/use-server --undo          back to running everything here (the .env from before)
set -euo pipefail
cd "$(dirname "$0")/.."
BACKUP=data/env.before-server

if [[ ${1:-} == --undo ]]; then
  [[ -f $BACKUP ]] || { echo "nothing to undo ($BACKUP is missing)" >&2; exit 1; }
  cp "$BACKUP" .env && chmod 600 .env
  rm -f ~/.config/home-core/url  # Claude Code's home-state skill: back to the core on this Mac
  echo "the Mac runs everything again: ./home reload (and ./home up for Home Assistant); bin/install-mcp for Claude Desktop"
  exit 0
fi
HOST=${1:?usage: server/use-server <server address> | --undo}
curl -sf -o /dev/null --max-time 5 "http://$HOST:8123/manifest.json" \
  || { echo "Home Assistant isn't answering at http://$HOST:8123; is the server up (./home up on the server)?" >&2; exit 1; }

[[ -f $BACKUP ]] || cp .env "$BACKUP"
./home down  # with the old .env, so Home Assistant here stops too
set_key() {  # KEY VALUE: replace or add
  grep -v "^$1=" .env > .env.tmp || true
  echo "$1=$2" >> .env.tmp
  mv .env.tmp .env
}
set_key HOME_DOCKER 0
set_key HOME_ONLY "music_sync,announce"
set_key HA_URL "ws://$HOST:8123/api/websocket"
set_key HA_HTTP "http://$HOST:8123"
set_key CORE_URL "http://$HOST:8790"
set_key BACKLIGHT_HOST "$HOST"
set_key ANNOUNCE_SERVE_PORT 8791
# the TV app is built with Home Assistant's address in it; Android TV doesn't reliably resolve .local names, so an IP
# (give the server a fixed one: a DHCP reservation on the router)
IP=$(python3 -c 'import socket, sys; print(socket.gethostbyname(sys.argv[1]))' "$HOST")
set_key TV_HA_HOST "$IP"
set_key WIDGET_HOST "$IP"
chmod 600 .env
./home up
# Claude on this Mac: the home-state skill (Claude Code) and the MCP (Claude Desktop) use the server's core
mkdir -p ~/.config/home-core && echo "http://$IP:8790" > ~/.config/home-core/url
bin/install-skill >/dev/null  # the newest copy of the skill, which reads that url file
bin/install-mcp >/dev/null
cat <<EOF
The Mac now runs music sync and announcements against the server at $HOST (undo: server/use-server --undo).
Claude Desktop's home-state tools now use the server's core: quit and reopen Desktop.
Still to do, once: tv-app/deploy --no-open   (rebuilds the TV app for $IP)
                    .venv/bin/python -m widget install --copy   (the phone widget, pointed at the server:
                    paste it over the Scriptable script)
Optional, Claude Code over HTTP: claude mcp add --transport http home-state http://$IP:8792/mcp \\
                    --header "Authorization: Bearer \$(cat ~/.config/home-core/token)"
EOF
